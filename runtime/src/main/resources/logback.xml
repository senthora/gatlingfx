<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>[%d{HH:mm:ss.SSS}][%level ][%logger{0}] %msg%n</pattern>
        </encoder>
    </appender>
    <logger name="io.gatling" level="OFF"/>
    <logger name="io.netty" level="OFF"/>
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>